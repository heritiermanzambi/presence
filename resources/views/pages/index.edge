<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Système de Présence - Accueil</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-gradient-to-br from-blue-900 to-indigo-950 min-h-screen flex flex-col items-center justify-center p-4 font-sans text-white">

  <div class="w-full max-w-2xl text-center space-y-8">
    <div class="space-y-3">
      <div class="text-5xl">⚡</div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
        Portail de Présence <span class="text-blue-400">Tokosss</span>
      </h1>
      <p class="text-gray-300 max-w-md mx-auto text-sm sm:text-base">
        Bienvenue sur la plateforme de gestion des présences. Veuillez sélectionner votre profil pour continuer.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      
      <a href="/student" class="group bg-white/10 hover:bg-white/20 border border-white/10 rounded-2xl p-6 text-center transition transform hover:-translate-y-1 hover:shadow-xl flex flex-col items-center space-y-4">
        <div class="bg-blue-500/20 text-blue-400 p-4 rounded-xl text-3xl group-hover:scale-110 transition">
          👨‍🎓
        </div>
        <div>
          <h2 class="text-xl font-bold">Étudiant</h2>
          <p class="text-gray-400 text-xs mt-1">Générer mon QR Code de présence.</p>
        </div>
      </a>

      <a href="/teacher" class="group bg-white/10 hover:bg-white/20 border border-white/10 rounded-2xl p-6 text-center transition transform hover:-translate-y-1 hover:shadow-xl flex flex-col items-center space-y-4">
        <div class="bg-green-500/20 text-green-400 p-4 rounded-xl text-3xl group-hover:scale-110 transition">
          👨‍🏫
        </div>
        <div>
          <h2 class="text-xl font-bold">Enseignant</h2>
          <p class="text-gray-400 text-xs mt-1">Ouvrir le scanner et valider les cours.</p>
        </div>
      </a>

      <a href="/director" class="group bg-white/10 hover:bg-white/20 border border-white/10 rounded-2xl p-6 text-center transition transform hover:-translate-y-1 hover:shadow-xl flex flex-col items-center space-y-4">
        <div class="bg-purple-500/20 text-purple-400 p-4 rounded-xl text-3xl group-hover:scale-110 transition">
          📊
        </div>
        <div>
          <h2 class="text-xl font-bold">Directeur</h2>
          <p class="text-gray-400 text-xs mt-1">Suivre les émargements en temps réel.</p>
        </div>
      </a>

    </div>
  </div>

</body>
</html>